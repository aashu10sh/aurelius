GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push (VAPID). Generate once with `bunx @pushforge/builder vapid` and paste the
# private JWK on one line. Changing it later invalidates every push subscription.
VAPID_PRIVATE_KEY=
# A contact for push services (Apple rejects localhost-style addresses).
VAPID_SUBJECT=mailto:you@example.com
